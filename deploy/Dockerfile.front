# Imagen del front del sandbox (Streamlit). Se construye desde la raíz del repo:
#   docker build -f deploy/Dockerfile.front -t front-cobranza .
# En Cloud Run obtiene el token de identidad de su cuenta de servicio para llamar a la API del agente.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PORT=8080

RUN useradd --create-home --uid 1000 app
WORKDIR /app
RUN pip install streamlit==1.63.0 httpx==0.28.1 pandas==2.2.3 python-dotenv==1.1.0 google-auth==2.58.0

COPY agente/front/ /app/agente/front/
RUN chown -R app:app /app
USER app

EXPOSE 8080
CMD ["sh", "-c", "streamlit run agente/front/app.py --server.port=${PORT} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false"]
