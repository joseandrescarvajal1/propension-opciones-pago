# Token de la API de Kaggle. Generar en https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave de la API local (en Cloud Run viene de Secret Manager)
API_KEY=cambia-esta-clave
# Carpeta del paquete de modelo (local o gs://bucket/modelos/v4)
MODELO_RUTA=models/v4

# ---- Parte 2: agente (Vertex AI, sin llaves de LLM; autenticación por ADC o cuenta de servicio)
GCP_PROJECT_ID=propension-opciones-pago
GCP_REGION=us-central1
LLM_MODELO=gemini-2.5-flash
# API del modelo de la Parte 1 que consume el agente (Cloud Run dev o local); si falla, usa el modelo local
MODELO_API_URL=http://127.0.0.1:8000
MODELO_API_KEY=cambia-esta-clave
# Clave de la API del agente
AGENTE_API_KEY=cambia-esta-clave-del-agente
# Ruta de la base del sandbox
SANDBOX_DB=agente/sandbox/sandbox.db
# Endpoint de Vertex para los LLM (global = menor latencia) y modelo pequeño para los guardrails
LLM_REGION=global
LLM_MODELO_GUARDRAIL=gemini-2.5-flash-lite
