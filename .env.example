# Token de la API de Kaggle. Generar en https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave de la API local (en Cloud Run viene de Secret Manager)
API_KEY=cambia-esta-clave
# Carpeta del paquete de modelo (local o gs://bucket/modelos/v4)
MODELO_RUTA=models/v4
